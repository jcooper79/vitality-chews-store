{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vitality-chews-store",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "account_id": "712e38517a7e6baf08301e3202ca5da8",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vitality-chews-orders",
      "database_id": "b2c5b208-7774-4984-900b-d7a76ad8552c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://vitalitychews.com",
    "STRIPE_AUTOMATIC_TAX": "false",
    "ORDER_EMAIL_FROM": "orders@vitalitychews.com",
    "MAIL_DOMAIN": "vitalitychews.com",
    "SUPPORT_EMAIL": "hello@vitalitychews.com",
    // Links in admin emails. Change to https://vitalitychews.com when the domain points at this Worker.
    "ADMIN_BASE_URL": "https://vitality-chews-store.resqware.workers.dev",
    // "false" = notices say only that a message arrived (no text); you then read and reply in the admin.
    "INBOX_NOTIFY_BODY": "true"
  },
  // Email: order/refund notices and inbox notices to ORDER_NOTIFY_TO (secret, a verified Email Routing address),
  // customer replies from SUPPORT_EMAIL. vitalitychews.com must be onboarded in Email Service > Email Sending,
  // and Email Routing's catch-all must send to this Worker for the inbox.
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [{ "binding": "MAIL_FILES", "bucket_name": "vitality-chews-mail" }],
  // Secrets (set with `wrangler secret put NAME` or in the dashboard):
  //   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SHIPSTATION_USER, SHIPSTATION_PASS, ORDER_NOTIFY_TO, INBOX_SECRET
  "observability": { "enabled": true }
}
