{
  "name": "vitality-chews-store",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply vitality-chews-orders --remote",
    "db:migrate:local": "wrangler d1 migrations apply vitality-chews-orders --local"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  },
  "dependencies": {
    "postal-mime": "^2.7.6"
  }
}
